generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  displayName  String   @db.VarChar(100)
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  disabledAt   DateTime? @db.Timestamptz(3)
  emailVerificationCredentials EmailVerificationCredential[]
  sessions     Session[]
  passwordResetCredentials PasswordResetCredential[]
  historialMaterias MateriaHistorial[]
  feedback Feedback[]
  aceptacionesNormas AceptacionNormas[]
  administracionHistorial AdministracionHistorial[]
  valoracionesMaterias ValoracionMateria[]
  feedbackLikes FeedbackLike[]
  feedbackRespuestas FeedbackRespuesta[]
  feedbackReportes FeedbackReporte[] @relation("DenuncianteReporte")
  reportesResueltos FeedbackReporte[] @relation("AdministradorReporte")

  @@index([role, disabledAt, createdAt, id])
}

model AceptacionNormas {
  usuarioId String   @db.Uuid
  version   String   @db.VarChar(32)
  aceptadaEn DateTime @default(now()) @db.Timestamptz(3)
  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, version])
}

model AdministracionHistorial {
  id String @id @default(uuid()) @db.Uuid
  entidad String @db.VarChar(16)
  entidadId String @db.Uuid
  actorId String @db.Uuid
  accion String @db.VarChar(24)
  cambios Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entidad, entidadId, createdAt, id])
}

model EmailVerificationCredential {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  createdAt     DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  deliveredAt   DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}


model PasswordResetCredential {
  id            String    @id @db.Uuid
  userId        String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  createdAt     DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  deliveredAt   DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @db.Timestamptz(3)
  lastActivityAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshCredentials RefreshCredential[]

  @@index([userId, createdAt])
}

model RefreshCredential {
  id            String    @id @db.Uuid
  sessionId     String    @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  createdAt     DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
}

enum Cuatrimestre {
  PRIMERO
  SEGUNDO
  ANUAL
}

enum ModalidadMateria {
  ANUAL
  PRIMERO
  SEGUNDO
}

enum Carrera {
  S
  C
  Q
  I
  M
}

enum CargoDocente {
  TITULAR
  ADJUNTO
  JTP
}

model Materia {
  id        String    @id @default(uuid()) @db.Uuid
  // Unicidad solo de registros vigentes y sin distinguir mayúsculas ni tildes: índice funcional
  // de la migración 20261107000000_materia_nombre_normalizado (Prisma no lo representa).
  nombre    String    @db.VarChar(150)
  modalidad ModalidadMateria?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  cursadas  Cursada[]
  historial MateriaHistorial[]
  carreras  MateriaCarrera[]
  valoraciones ValoracionMateria[]
}

model ValoracionMateria {
  usuarioId String @db.Uuid
  materiaId String @db.Uuid
  // CHECK de puntuacion entre 1 y 5 en la migración SQL.
  puntuacion Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([usuarioId, materiaId])
  @@index([materiaId, deletedAt])
}

model MateriaCarrera {
  materiaId     String  @db.Uuid
  carrera       Carrera
  anioCarrera   String  @db.VarChar(8)
  nivelElectiva String? @db.VarChar(1)
  materia       Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)

  @@id([materiaId, carrera])
  @@index([carrera, anioCarrera, nivelElectiva])
}

model MateriaHistorial {
  id String @id @default(uuid()) @db.Uuid
  materiaId String @db.Uuid
  actorId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  cambios Json
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([materiaId, createdAt, id])
}

model Profesor {
  id             String    @id @default(uuid()) @db.Uuid
  nombreCompleto String    @db.VarChar(150)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  comisiones     ComisionProfesor[]
  feedback       Feedback[]
}

model Cursada {
  id           String       @id @default(uuid()) @db.Uuid
  materiaId    String       @db.Uuid
  anio         Int
  // Los registros legados sin período se conservan; las nuevas altas exigen uno.
  cuatrimestre Cuatrimestre?
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  deletedAt    DateTime?    @db.Timestamptz(3)
  materia      Materia      @relation(fields: [materiaId], references: [id], onDelete: Restrict)
  comisiones   Comision[]

  // Índice único parcial (materiaId,anio,cuatrimestre) WHERE deletedAt IS NULL en SQL.
  @@index([materiaId])
}

model Comision {
  id        String    @id @default(uuid()) @db.Uuid
  cursadaId String    @db.Uuid
  activa    Boolean   @default(true)
  carrera   Carrera
  numero    Int
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  cursada   Cursada   @relation(fields: [cursadaId], references: [id], onDelete: Restrict)
  profesores ComisionProfesor[]
  feedback Feedback[]

  // Índice único parcial (cursadaId,carrera,numero) WHERE deletedAt IS NULL en SQL.
  @@index([cursadaId])
}

model ComisionProfesor {
  comisionId String       @db.Uuid
  profesorId String       @db.Uuid
  cargo      CargoDocente
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  comision   Comision     @relation(fields: [comisionId], references: [id], onDelete: Restrict)
  profesor   Profesor     @relation(fields: [profesorId], references: [id], onDelete: Restrict)

  @@id([comisionId, profesorId])
  @@index([profesorId])
}

enum FeedbackEstadoModeracion {
  PENDIENTE
  APROBADO
  RECHAZADO
}

model Feedback {
  id String @id @default(uuid()) @db.Uuid
  autorId String @db.Uuid
  comisionId String @db.Uuid
  profesorId String? @db.Uuid
  texto String @db.Text
  // NULL para comentarios históricos; CHECK de 1 a 5 en la migración SQL.
  puntuacion Int?
  anonimo Boolean
  estadoModeracion FeedbackEstadoModeracion @default(PENDIENTE)
  versionModeracion Int @default(1)
  requiereRevisionHumana Boolean @default(false)
  motivoRechazo String? @db.VarChar(1000)
  ocultoAutor Boolean @default(false)
  ocultoAdministracion Boolean @default(false)
  ocultoReportes Boolean @default(false)
  comisionNombre String @db.VarChar(10)
  materiaId String @db.Uuid
  materiaNombre String @db.VarChar(150)
  cursadaId String @db.Uuid
  anio Int
  cuatrimestre Cuatrimestre?
  modalidad ModalidadMateria?
  profesorNombre String? @db.VarChar(150)
  profesorCargo CargoDocente?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  autor User @relation(fields: [autorId], references: [id], onDelete: Restrict)
  comision Comision @relation(fields: [comisionId], references: [id], onDelete: Restrict)
  profesor Profesor? @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  historial FeedbackHistorial[]
  likes FeedbackLike[]
  respuestas FeedbackRespuesta[]
  reportes FeedbackReporte[]

  // UNIQUE parcial (autorId,comisionId) WHERE deletedAt IS NULL vive en la migración SQL.
  @@index([comisionId, deletedAt, createdAt, id])
  @@index([profesorId, deletedAt, createdAt, id])
  @@index([autorId, comisionId])
  @@index([autorId, materiaId, deletedAt])
  @@index([deletedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([estadoModeracion, deletedAt, createdAt, id])
}

model FeedbackLike {
  usuarioId String @db.Uuid
  feedbackId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  usuario User @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Una identidad por par, también durante la baja; reactivar la misma fila.
  @@id([usuarioId, feedbackId])
  @@index([feedbackId, deletedAt])
}

model FeedbackRespuesta {
  id String @id @default(uuid()) @db.Uuid
  feedbackId String @db.Uuid
  autorId String @db.Uuid
  texto String @db.Text
  anonimo Boolean
  solicitudId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  autor User @relation(fields: [autorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  historial FeedbackRespuestaHistorial[]

  // No liberar la clave al eliminar: un reintento no puede recrear la respuesta.
  @@unique([autorId, solicitudId])
  @@index([feedbackId, deletedAt, createdAt, id])
}

model FeedbackRespuestaHistorial {
  id String @id @default(uuid()) @db.Uuid
  respuestaId String @db.Uuid
  accion FeedbackAccion
  texto String @db.Text
  anonimo Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  respuesta FeedbackRespuesta @relation(fields: [respuestaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Snapshots inmutables como FeedbackHistorial; el actor se audita en AdministracionHistorial.
  @@index([respuestaId, createdAt, id])
}

enum FeedbackAccion {
  CREACION
  EDICION
  ELIMINACION
  APROBACION
  RECHAZO
  OCULTAMIENTO_AUTOR
  RESTITUCION_AUTOR
  OCULTAMIENTO_ADMIN
  RESTITUCION_ADMIN
  SOLICITUD_REVISION
}

model FeedbackHistorial {
  id String @id @default(uuid()) @db.Uuid
  feedbackId String @db.Uuid
  accion FeedbackAccion
  texto String @db.Text
  // Los snapshots históricos conservan NULL; CHECK de 1 a 5 en SQL.
  puntuacion Int?
  anonimo Boolean
  // NULL means no moderation evidence exists for this historical snapshot.
  estadoModeracion FeedbackEstadoModeracion?
  versionModeracion Int?
  requiereRevisionHumana Boolean?
  motivoRechazo String? @db.VarChar(1000)
  ocultoAutor Boolean?
  ocultoAdministracion Boolean?
  ocultoReportes Boolean?
  motivoModeracion String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  reportes FeedbackReporte[]

  @@unique([feedbackId, id])
  @@index([feedbackId, createdAt, id])
}

enum FeedbackReporteMotivo {
  INSULTOS_ACOSO
  AMENAZAS_INTIMIDACION
  DISCRIMINACION
  DATOS_PERSONALES
  SPAM
  OTRO
}

enum FeedbackReporteEstado {
  ABIERTO
  RESUELTO
  DESESTIMADO
}

model FeedbackReporte {
  id String @id @default(uuid()) @db.Uuid
  feedbackId String @db.Uuid
  denuncianteId String @db.Uuid
  versionReportada Int
  historialId String @db.Uuid
  motivo FeedbackReporteMotivo
  descripcion String? @db.VarChar(1000)
  estado FeedbackReporteEstado @default(ABIERTO)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  resolvedAt DateTime? @db.Timestamptz(3)
  administradorId String? @db.Uuid
  justificacion String? @db.VarChar(1000)
  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  denunciante User @relation("DenuncianteReporte", fields: [denuncianteId], references: [id], onDelete: Restrict)
  administrador User? @relation("AdministradorReporte", fields: [administradorId], references: [id], onDelete: Restrict)
  historial FeedbackHistorial @relation(fields: [feedbackId, historialId], references: [feedbackId, id], onDelete: Restrict)

  @@unique([denuncianteId, feedbackId, versionReportada])
  @@index([denuncianteId, createdAt])
  @@index([feedbackId, estado, denuncianteId])
  @@index([estado, createdAt(sort: Desc), id(sort: Desc)])
  @@index([motivo, createdAt(sort: Desc), id(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
