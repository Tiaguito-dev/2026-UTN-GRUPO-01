# Copiar como .env para desarrollo local. No guardar secretos reales en Git.

# PostgreSQL local (Docker Compose)
POSTGRES_DB=utn_grupo_01
POSTGRES_USER=utn
POSTGRES_PASSWORD=
# Puerto publicado en el host; dentro de Docker PostgreSQL conserva 5432.
POSTGRES_PORT=55449

# Backend y Prisma
# Completar para npm local con el mismo usuario/base/contraseña; Compose construye su URL interna.
DATABASE_URL=
BACKEND_PORT=3001

# Provisión administrativa explícita (completar solo en configuración privada)
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=

# Base exclusiva de pruebas de integración (sin fallback a DATABASE_URL)
TEST_DATABASE_URL=

# Autenticación HTTP: completar secreto aleatorio base64url >=32 bytes en configuración privada.
# Sin secreto, emisor, audiencia y orígenes válidos el backend no inicia.
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=profesor-butchery
AUTH_JWT_AUDIENCE=profesor-butchery-web
AUTH_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=604800

# Desarrollo local explícito. En producción: NODE_ENV=production, HTTPS y flag=false.
NODE_ENV=development
AUTH_ALLOW_LOCAL_HTTP=true
AUTH_PUBLIC_URL=http://localhost:3001
AUTH_ALLOWED_ORIGINS=http://localhost:3000
AUTH_COOKIE_SAME_SITE=lax
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_REFRESH_MAX_ATTEMPTS=30
AUTH_REFRESH_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_PASSWORD_RESET_URL=http://localhost:3000/reset-password
AUTH_PASSWORD_RESET_MIN_RESPONSE_MS=2000
AUTH_FORGOT_PASSWORD_MAX_ATTEMPTS=5
AUTH_FORGOT_PASSWORD_WINDOW_SECONDS=900
AUTH_RESET_PASSWORD_MAX_ATTEMPTS=10
AUTH_RESET_PASSWORD_WINDOW_SECONDS=900
AUTH_CHANGE_PASSWORD_MAX_ATTEMPTS=10
AUTH_CHANGE_PASSWORD_WINDOW_SECONDS=900
# Omitir si no hay proxy. Solo IP/CIDR de proxies controlados, nunca true o cantidad de saltos.
# AUTH_TRUSTED_PROXIES=

# Buzón local: docker compose -f docker-compose.dev.yml --profile mail up -d mailpit
# En producción: SMTP_ALLOW_LOCAL_PLAINTEXT=false, TLS y credenciales privadas requeridos.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@profesor-butchery.local
SMTP_SECURE=false
SMTP_ALLOW_LOCAL_PLAINTEXT=true
SMTP_TIMEOUT_MS=1500
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ALLOW_LOCAL_HTTP=true
# En producción: API HTTPS y NEXT_PUBLIC_ALLOW_LOCAL_HTTP=false. Se fijan durante next build.

# Stack Docker de desarrollo (HTTP local mediante Nginx, sin certificados)
DOCKER_PUBLIC_URL=http://localhost:8080
DOCKER_HTTP_PORT=8080
DOCKER_APP_SUBNET=192.168.240.0/24
DOCKER_PROXY_IP=192.168.240.10
# docker-compose.dev.yml fija development y habilita HTTP únicamente en loopback.
DOCKER_SMTP_HOST=mailpit
DOCKER_SMTP_PORT=1025
DOCKER_SMTP_SECURE=false
DOCKER_SMTP_ALLOW_LOCAL_PLAINTEXT=true
DOCKER_SMTP_LOCAL_PLAINTEXT_HOSTS=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
# Producción usa un archivo privado diferente; docker-compose.yml fija production y SMTP TLS.
# Configurar DOCKER_PUBLIC_URL público, DOCKER_SMTP_HOST/PORT (SMTPS, normalmente 465),
# SMTP_FROM, SMTP_USERNAME, SMTP_PASSWORD y DOCKER_TLS_DIRECTORY (cert.pem + key.pem).
# No reutilizar la subred de desarrollo: configurar DOCKER_APP_SUBNET y DOCKER_PROXY_IP coherentes.
# DOCKER_TLS_DIRECTORY=
# DOCKER_BIND_ADDRESS=127.0.0.1
# DOCKER_HTTPS_PORT=8443
