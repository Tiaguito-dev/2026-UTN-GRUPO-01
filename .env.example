# Copiar como .env para desarrollo local. No guardar secretos reales en Git.
# Ver docs/tdd/TDD-INFRA-CLOUD-H1.md para la arquitectura de despliegue en la nube.

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
# En Desarrollo Local (Docker Compose):
POSTGRES_DB=utn_grupo_01
POSTGRES_USER=utn
POSTGRES_PASSWORD=utn_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://utn:utn_local_password@localhost:5432/utn_grupo_01?schema=public

# En Producción (Neon PostgreSQL para el backend en Render / Cloud):
# Formato provisto por Neon (con SSL obligatorio):
# DATABASE_URL=postgresql://<usuario>:<password>@<endpoint>.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Backend (NestJS)
# ------------------------------------------------------------------------------
# Puerto local en el que escucha NestJS (Render asigna su propio PORT dinámicamente)
BACKEND_PORT=3001

# ------------------------------------------------------------------------------
# 3. Frontend (Next.js)
# ------------------------------------------------------------------------------
# URL del backend al que consulta el frontend:
# - En Local: http://localhost:3001
# - En Producción (Vercel): https://<tu-backend>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:3001
