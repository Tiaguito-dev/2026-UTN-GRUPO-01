# Copiar como .env para desarrollo local. No guardar secretos reales en Git.

# PostgreSQL local (Docker Compose)
POSTGRES_DB=utn_grupo_01
POSTGRES_USER=utn
POSTGRES_PASSWORD=utn_local_password
POSTGRES_PORT=5432

# Backend y Prisma
DATABASE_URL=postgresql://utn:utn_local_password@localhost:5432/utn_grupo_01?schema=public
BACKEND_PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
